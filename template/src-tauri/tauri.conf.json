{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web2Exe App",
  "version": "0.1.0",
  "identifier": "com.example.web2exe-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Web2Exe 应用",
        "width": 1120,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "WebView2Loader.dll"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2MDQ2RDhFNDhBNjhERDIKUldUU2phWklqbTBFNXRGbmxtajBwWjYvNVdZVzRGSThEOGVtYWxQWjFBeHFIbzB6Q0V6YnRFTm0K",
      "endpoints": [
        "https://your-host.example.com/web2exe/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
